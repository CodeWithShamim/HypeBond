# Deployed HypeBond contract address (from `pnpm deploy:contract`)
VITE_HYPEBOND_ADDRESS=

# "studionet" (local GenLayer Studio) or "testnet-asimov"
VITE_GENLAYER_NETWORK=studionet

# Privy app id (dashboard.privy.io) — enables email / social login with an
# embedded wallet. Leave blank to fall back to MetaMask + guest wallet only.
VITE_PRIVY_APP_ID=

# Needed only for deploying to testnet-asimov (funded key, GEN from faucet)
DEPLOYER_PRIVATE_KEY=
